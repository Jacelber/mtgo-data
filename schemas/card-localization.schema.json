{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacelber.github.io/mtgo-data/schemas/card-localization.schema.json",
  "title": "Synthetic card-localization manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cards",
    "fixture_mode",
    "product",
    "public_prefix",
    "schema_version",
    "source_snapshot",
    "subject_sha256"
  ],
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/card"}
    },
    "fixture_mode": {"const": true},
    "product": {"const": "card-localization"},
    "public_prefix": {"const": "assets/card-localization/v1"},
    "schema_version": {"const": "1.0.0"},
    "source_snapshot": {"$ref": "#/$defs/source_snapshot"},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sha256", "snapshot_id"],
      "properties": {
        "provider": {"const": "mtgch"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "snapshot_id": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribution", "contributor", "field", "provider"],
      "properties": {
        "attribution": {"type": "string", "minLength": 1},
        "contributor": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "field": {
          "enum": [
            "atomic_official_name",
            "atomic_translated_name",
            "face_name",
            "image_uris.normal",
            "name",
            "zhs_image_uris.normal",
            "zhs_face_name",
            "zhs_name"
          ]
        },
        "provider": {"enum": ["mtgch", "scryfall"]}
      }
    },
    "localized_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "status", "value"],
      "properties": {
        "provenance": {"$ref": "#/$defs/provenance"},
        "status": {"enum": ["official", "community", "english_fallback"]},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "official"}}},
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "contributor": {"type": "null"},
                  "field": {
                    "enum": ["atomic_official_name", "zhs_face_name", "zhs_name"]
                  },
                  "provider": {"const": "mtgch"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "community"}}},
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "contributor": {"type": "string", "minLength": 1},
                  "field": {"const": "atomic_translated_name"},
                  "provider": {"const": "mtgch"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "english_fallback"}}},
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "contributor": {"type": "null"},
                  "field": {"enum": ["face_name", "name"]},
                  "provider": {"const": "scryfall"}
                }
              }
            }
          }
        }
      ]
    },
    "localized_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "local_path",
        "media_type",
        "provenance",
        "sha256",
        "source_uri",
        "status"
      ],
      "properties": {
        "bytes": {
          "oneOf": [
            {"type": "integer", "minimum": 12, "maximum": 5242880},
            {"type": "null"}
          ]
        },
        "local_path": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^assets/card-localization/v1/images/[0-9a-f]{64}\\.webp$"
            },
            {"type": "null"}
          ]
        },
        "media_type": {
          "oneOf": [
            {"const": "image/webp"},
            {"type": "null"}
          ]
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "source_uri": {"type": "string", "format": "uri"},
        "status": {"enum": ["official", "community", "english_fallback"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"enum": ["official", "community"]}}
          },
          "then": {
            "properties": {
              "bytes": {"type": "integer", "minimum": 12, "maximum": 5242880},
              "local_path": {
                "type": "string",
                "pattern": "^assets/card-localization/v1/images/[0-9a-f]{64}\\.webp$"
              },
              "media_type": {"const": "image/webp"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_uri": {
                "type": "string",
                "pattern": "^https://images\\.mtgch\\.com/"
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "official"}}},
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "contributor": {"type": "null"},
                  "field": {"const": "zhs_image_uris.normal"},
                  "provider": {"const": "mtgch"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "community"}}},
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "contributor": {"type": "string", "minLength": 1},
                  "field": {"const": "zhs_image_uris.normal"},
                  "provider": {"const": "mtgch"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "english_fallback"}}},
          "then": {
            "properties": {
              "bytes": {"type": "null"},
              "local_path": {"type": "null"},
              "media_type": {"type": "null"},
              "provenance": {
                "properties": {
                  "contributor": {"type": "null"},
                  "field": {"const": "image_uris.normal"},
                  "provider": {"const": "scryfall"}
                }
              },
              "sha256": {"type": "null"},
              "source_uri": {
                "type": "string",
                "pattern": "^https://[^/]+\\.scryfall\\.io/"
              }
            }
          }
        }
      ]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "english_name",
        "face_index",
        "image",
        "name",
        "oracle_id",
        "scryfall_id"
      ],
      "properties": {
        "english_name": {"type": "string", "minLength": 1},
        "face_index": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "image": {"$ref": "#/$defs/localized_image"},
        "name": {"$ref": "#/$defs/localized_name"},
        "oracle_id": {"type": "string", "format": "uuid"},
        "scryfall_id": {"type": "string", "format": "uuid"}
      },
      "allOf": [
        {
          "if": {"properties": {"face_index": {"type": "integer"}}},
          "then": {
            "properties": {
              "name": {
                "allOf": [
                  {
                    "if": {"properties": {"status": {"const": "official"}}},
                    "then": {
                      "properties": {
                        "provenance": {
                          "properties": {
                            "field": {
                              "enum": ["atomic_official_name", "zhs_face_name"]
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {"status": {"const": "english_fallback"}}
                    },
                    "then": {
                      "properties": {
                        "provenance": {
                          "properties": {"field": {"const": "face_name"}}
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "name": {
                "allOf": [
                  {
                    "if": {"properties": {"status": {"const": "official"}}},
                    "then": {
                      "properties": {
                        "provenance": {
                          "properties": {
                            "field": {
                              "enum": ["atomic_official_name", "zhs_name"]
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {"status": {"const": "english_fallback"}}
                    },
                    "then": {
                      "properties": {
                        "provenance": {
                          "properties": {"field": {"const": "name"}}
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
