{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacelber.github.io/mtgo-data/schemas/mtgo-archetype-names.schema.json",
  "title": "Private MTGO bilingual archetype-name catalog",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "names"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "names": {
      "type": "array",
      "items": {"$ref": "#/$defs/name"}
    }
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "parent_id", "subtype_id", "english", "chinese",
        "review_status", "identity_key"
      ],
      "properties": {
        "format": {"enum": ["standard", "modern"]},
        "parent_id": {"$ref": "#/$defs/stableId"},
        "subtype_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/stableId"}
          ]
        },
        "english": {"type": "string", "minLength": 1},
        "chinese": {"type": "string", "minLength": 1},
        "review_status": {"const": "approved"},
        "identity_key": {
          "type": "string",
          "pattern": "^(standard|modern)\\|[a-z0-9]+(?:-[a-z0-9]+)*\\|(?:none|[a-z0-9]+(?:-[a-z0-9]+)*)$"
        }
      }
    }
  }
}
