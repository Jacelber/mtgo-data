{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacelber.github.io/mtgo-data/schemas/landing-card-image-cache.schema.json",
  "title": "MTGO Landing card-image cache manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bulk_data_sha256",
    "cards",
    "formats",
    "product",
    "public_prefix",
    "schema_version",
    "subject_sha256",
    "window_size_weeks"
  ],
  "properties": {
    "bulk_data_sha256": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "cards": {
      "type": "array",
      "items": {"$ref": "#/$defs/card"}
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/format_window"}
    },
    "product": {"const": "mtgo-landing-card-image-cache"},
    "public_prefix": {"const": "assets/card-cache/v1"},
    "schema_version": {"const": "1.1.0"},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "window_size_weeks": {"const": 4}
  },
  "$defs": {
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3])$"
    },
    "format_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_week",
        "format",
        "selected_weeks",
        "window_end",
        "window_start"
      ],
      "properties": {
        "anchor_week": {"$ref": "#/$defs/week"},
        "format": {"enum": ["standard", "modern"]},
        "selected_weeks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/week"}
        },
        "window_end": {"$ref": "#/$defs/week"},
        "window_start": {"$ref": "#/$defs/week"}
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "weeks"],
      "properties": {
        "format": {"enum": ["standard", "modern"]},
        "weeks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/week"}
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "cache_source",
        "face_index",
        "local_path",
        "name",
        "oracle_id",
        "scryfall_id",
        "sha256",
        "source_image_uri",
        "uses"
      ],
      "properties": {
        "bytes": {"type": "integer", "minimum": 8, "maximum": 5242880},
        "cache_source": {"const": "generated"},
        "face_index": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "local_path": {
          "type": "string",
          "pattern": "^assets/card-cache/v1/images/[0-9a-f-]+(?:-face-[0-9]+)?\\.jpg$"
        },
        "name": {"type": "string", "minLength": 1},
        "oracle_id": {"type": "string", "format": "uuid"},
        "scryfall_id": {"type": "string", "format": "uuid"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_image_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+\\.scryfall\\.io/"
        },
        "uses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/use"}
        }
      }
    }
  }
}
