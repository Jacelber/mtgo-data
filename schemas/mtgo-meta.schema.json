{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacelber.github.io/mtgo-data/schemas/mtgo-meta.schema.json",
  "title": "MTGO format metadata",
  "x-schema-version": "1.1.0",
  "type": "object",
  "required": ["schema_version", "format", "source", "rules_updated", "data_updated"],
  "properties": {
    "publication": {
      "type": "object",
      "required": ["scope_digest", "week", "artifacts"],
      "properties": {
        "scope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^(stats|reports)/(standard|modern)/mtgo/.+\\.json$"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "additionalProperties": false
    },
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "format": {"enum": ["standard", "modern"]}, "source": {"const": "mtgo"},
    "rules_updated": {"type": "string", "minLength": 1}, "data_updated": {"type": "string", "minLength": 1},
    "statistics_catalog": {"const": "index.json"},
    "matchup_catalog": {"const": "matchup_index.json"},
    "hierarchy_catalog": {"const": "archetype_hierarchy.json"},
    "top8_catalog": {
      "oneOf": [
        {"const": "top8/index.json"},
        {"type": "null"}
      ]
    },
    "completeness_catalog": {
      "oneOf": [
        {"const": "completeness/index.json"},
        {"type": "null"}
      ]
    },
    "pickup_catalog": {
      "oneOf": [
        {"const": "pickup/index.json"},
        {"type": "null"}
      ]
    },
    "landing_document": {
      "oneOf": [
        {"const": "landing/current.json"},
        {"type": "null"}
      ]
    },
    "landing_feature_catalog": {
      "oneOf": [
        {"const": "landing/features/index.json"},
        {"type": "null"}
      ]
    },
    "matchup_source": {"const": "Videre"},
    "matchup_coverage": {
      "type": "object",
      "required": [
        "official_events",
        "events_with_archives",
        "events_without_archives",
        "stored_archives",
        "archives_outside_official_events"
      ],
      "properties": {
        "official_events": {"type": "integer", "minimum": 0},
        "events_with_archives": {"type": "integer", "minimum": 0},
        "events_without_archives": {"type": "integer", "minimum": 0},
        "stored_archives": {"type": "integer", "minimum": 0},
        "archives_outside_official_events": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}},
      "then": {"required": ["publication"]}
    },
    {
      "required": [
        "statistics_catalog",
        "matchup_catalog",
        "hierarchy_catalog",
        "top8_catalog",
        "completeness_catalog",
        "pickup_catalog",
        "landing_document",
        "landing_feature_catalog",
        "matchup_source",
        "matchup_coverage"
      ]
    }
  ],
  "additionalProperties": false
}
