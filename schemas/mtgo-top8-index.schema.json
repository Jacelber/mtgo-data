{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacelber.github.io/mtgo-data/schemas/mtgo-top8-index.schema.json",
  "title": "MTGO weekly Top 8 catalog",
  "x-schema-version": "1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "source",
    "format",
    "classifier_digest",
    "generated",
    "latest_complete_week",
    "history_policy",
    "classification_impact",
    "weeks"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "document_type": {"const": "top8_index"},
    "source": {"const": "mtgo"},
    "format": {"enum": ["standard", "modern"]},
    "classifier_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated": {"type": "string", "minLength": 1},
    "latest_complete_week": {"type": "string", "format": "date"},
    "history_policy": {"const": "source_immutable_classifier_restatement"},
    "classification_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weeks", "summary"],
      "properties": {
        "weeks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/weekImpact"}
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retained_week_count",
            "added_event_count",
            "classification_change_count"
          ],
          "properties": {
            "retained_week_count": {"type": "integer", "minimum": 1},
            "added_event_count": {"type": "integer", "minimum": 0},
            "classification_change_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "comparison_bases_file",
          "start",
          "end",
          "event_count",
          "status",
          "provisional_through",
          "seal_on"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[0-9]{4}-W[0-9]{2}\\.json$"
          },
          "comparison_bases_file": {
            "type": "string",
            "pattern": "^[0-9]{4}-W[0-9]{2}-bases\\.json$"
          },
          "start": {"type": "string", "format": "date"},
          "end": {"type": "string", "format": "date"},
          "event_count": {"type": "integer", "minimum": 1},
          "status": {"enum": ["provisional", "sealed"]},
          "provisional_through": {"type": "string", "format": "date"},
          "seal_on": {"type": "string", "format": "date"}
        }
      }
    }
  },
  "$defs": {
    "identityOrNull": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:[-/][a-z0-9]+)*$"
    },
    "identityList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[-/][a-z0-9]+)*$"
      }
    },
    "weekImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week",
        "previous_classifier_digest",
        "added_event_ids",
        "classification_changes",
        "comparison_base_changes"
      ],
      "properties": {
        "week": {"type": "string", "format": "date"},
        "previous_classifier_digest": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "added_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9]+$"}
        },
        "classification_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "rank", "before", "after"],
            "properties": {
              "event_id": {"type": "string", "pattern": "^[0-9]+$"},
              "rank": {"type": "integer", "minimum": 1, "maximum": 8},
              "before": {"$ref": "#/$defs/identityOrNull"},
              "after": {"$ref": "#/$defs/identityOrNull"}
            }
          }
        },
        "comparison_base_changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "added_identity_ids",
            "removed_identity_ids",
            "changed_identity_ids"
          ],
          "properties": {
            "added_identity_ids": {"$ref": "#/$defs/identityList"},
            "removed_identity_ids": {"$ref": "#/$defs/identityList"},
            "changed_identity_ids": {"$ref": "#/$defs/identityList"}
          }
        }
      }
    }
  }
}
