{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacelber.github.io/mtgo-data/schemas/classifier-color-diagnostics.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "archetype_id",
      "colors",
      "missing",
      "mana_support",
      "basic_land_types",
      "contributions"
    ],
    "properties": {
      "archetype_id": {
        "type": "string",
        "minLength": 1
      },
      "colors": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "white",
            "blue",
            "black",
            "red",
            "green"
          ]
        }
      },
      "missing": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "mana_support": {
        "description": "Normal land colors supporting classification uses; excludes incidental artifact mana, restricted sources, luck-dependent Caverns and a singleton Mycosynth Gardens. Not all technically possible mana production.",
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "white",
            "blue",
            "black",
            "red",
            "green"
          ]
        }
      },
      "basic_land_types": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "Plains",
            "Island",
            "Swamp",
            "Mountain",
            "Forest"
          ]
        }
      },
      "contributions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "card",
            "zone",
            "quantity",
            "colors",
            "reason"
          ],
          "properties": {
            "card": {
              "type": "string",
              "minLength": 1
            },
            "zone": {
              "enum": [
                "main",
                "side"
              ]
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "colors": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "white",
                  "blue",
                  "black",
                  "red",
                  "green"
                ]
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
