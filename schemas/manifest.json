{
  "schema_version": "1.0.0",
  "profile": "public-generated-json",
  "output_schema_version_embedded": true,
  "note": "Compatibility contract for public MTGO and Tabletop Major Events generated output with embedded schema_version.",
  "mappings": [
    {"pattern": "stats/catalog.json", "schema": "consumer-catalog.schema.json"},
    {"pattern": "stats/standard/archetype_names.json", "schema": "mtgo-archetype-localization.schema.json"},
    {"pattern": "stats/modern/archetype_names.json", "schema": "mtgo-archetype-localization.schema.json"},
    {"pattern": "stats/*/mtgo/range_*w.json", "schema": "mtgo-range.schema.json"},
    {"pattern": "stats/*/mtgo/decks_*w.json", "schema": "mtgo-decks.schema.json"},
    {"pattern": "stats/*/mtgo/index.json", "schema": "mtgo-catalog.schema.json"},
    {"pattern": "stats/*/mtgo/top8/index.json", "schema": "mtgo-top8-index.schema.json"},
    {"pattern": "stats/*/mtgo/top8/[0-9][0-9][0-9][0-9]-W[0-9][0-9].json", "schema": "mtgo-top8-week.schema.json"},
    {"pattern": "stats/*/mtgo/top8/[0-9][0-9][0-9][0-9]-W[0-9][0-9]-bases.json", "schema": "mtgo-top8-comparison-bases.schema.json"},
    {"pattern": "stats/*/mtgo/completeness/index.json", "schema": "mtgo-completeness-index.schema.json"},
    {"pattern": "stats/*/mtgo/completeness/[0-9]*w.json", "schema": "mtgo-completeness-range.schema.json"},
    {"pattern": "stats/*/mtgo/matchup_[0-9]*w.json", "schema": "mtgo-matchup.schema.json"},
    {"pattern": "stats/*/mtgo/matchup_index.json", "schema": "mtgo-matchup-catalog.schema.json"},
    {"pattern": "stats/*/mtgo/archetype_hierarchy.json", "schema": "mtgo-archetype-hierarchy.schema.json"},
    {"pattern": "stats/*/mtgo/meta.json", "schema": "mtgo-meta.schema.json"},
    {"pattern": "stats/standard/mtgo/landing/current.json", "schema": "mtgo-landing.schema.json"},
    {"pattern": "stats/modern/mtgo/landing/current.json", "schema": "mtgo-landing.schema.json"},
    {"pattern": "stats/standard/mtgo/landing/features/index.json", "schema": "mtgo-landing-feature-index.schema.json"},
    {"pattern": "stats/standard/mtgo/landing/features/[0-9][0-9][0-9][0-9]-W[0-9][0-9].json", "schema": "mtgo-landing-feature-week.schema.json"},
    {"pattern": "stats/modern/mtgo/landing/features/index.json", "schema": "mtgo-landing-feature-index.schema.json"},
    {"pattern": "stats/modern/mtgo/landing/features/[0-9][0-9][0-9][0-9]-W[0-9][0-9].json", "schema": "mtgo-landing-feature-week.schema.json"},
    {"pattern": "stats/standard/mtgo/pickup/index.json", "schema": "mtgo-pickup-index.schema.json"},
    {"pattern": "stats/standard/mtgo/pickup/[0-9][0-9][0-9][0-9]-W[0-9][0-9].json", "schema": "mtgo-pickup-week.schema.json"},
    {"pattern": "stats/modern/mtgo/pickup/index.json", "schema": "mtgo-pickup-index.schema.json"},
    {"pattern": "stats/modern/mtgo/pickup/[0-9][0-9][0-9][0-9]-W[0-9][0-9].json", "schema": "mtgo-pickup-week.schema.json"},
    {"pattern": "reports/*/mtgo/index.json", "schema": "classification-report-index.schema.json"},
    {"pattern": "reports/*/mtgo/unknown_decks.json", "schema": "classification-report.schema.json"},
    {"pattern": "reports/*/mtgo/multiple_matches.json", "schema": "classification-report.schema.json"},
    {"pattern": "reports/*/mtgo/classification_conflicts.json", "schema": "classification-report.schema.json"},
    {"pattern": "reports/*/mtgo/overridden_matches.json", "schema": "classification-report.schema.json"},
    {"pattern": "reports/*/mtgo/subtype_diagnostics.json", "schema": "classification-report.schema.json"},
    {"pattern": "stats/*/melee/events/*/overview.json", "schema": "melee-event-overview.schema.json"},
    {"pattern": "stats/*/melee/events/*/decks.json", "schema": "melee-event-decks.schema.json"},
    {"pattern": "stats/*/melee/events/*/matchup.json", "schema": "melee-event-matchup.schema.json"},
    {"pattern": "stats/*/melee/events/*/quality.json", "schema": "melee-event-quality.schema.json"},
    {"pattern": "stats/*/melee/events/*/meta.json", "schema": "melee-event-meta.schema.json"},
    {"pattern": "stats/*/melee/index.json", "schema": "melee-event-catalog.schema.json"}
  ]
}
