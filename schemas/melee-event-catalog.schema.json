{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jacelber/mtgo-data/schemas/melee-event-catalog.schema.json",
  "x-schema-version": "1.2.0",
  "title": "Tabletop Major Events format catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "source",
    "product",
    "format",
    "default_event_id",
    "events"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "document_type": {"const": "event_catalog"},
    "source": {"const": "melee"},
    "product": {"const": "tabletop-major-events"},
    "format": {"$ref": "melee-event-statistics-common.schema.json#/$defs/id"},
    "active_taxonomy": {"$ref": "#/$defs/active_taxonomy"},
    "default_event_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "active_taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "taxonomy_schema_version",
        "taxonomy_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "taxonomy_schema_version": {"type": "string", "minLength": 1},
        "taxonomy_sha256": {"$ref": "melee-event-statistics-common.schema.json#/$defs/sha256"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "name",
        "series",
        "date",
        "event_structure",
        "source_url",
        "meta",
        "overview",
        "decks",
        "matchup",
        "quality",
        "scope_order",
        "default_scope",
        "quality_status"
      ],
      "properties": {
        "event_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "series": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "date": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"}
          }
        },
        "event_structure": {
          "enum": ["mixed", "constructed_day2", "constructed_single_stage"]
        },
        "source_url": {"type": "string", "format": "uri"},
        "meta": {"type": "string", "pattern": "^events/[1-9][0-9]*/meta\\.json$"},
        "overview": {"type": "string", "pattern": "^events/[1-9][0-9]*/overview\\.json$"},
        "decks": {"type": "string", "pattern": "^events/[1-9][0-9]*/decks\\.json$"},
        "matchup": {"type": "string", "pattern": "^events/[1-9][0-9]*/matchup\\.json$"},
        "quality": {"type": "string", "pattern": "^events/[1-9][0-9]*/quality\\.json$"},
        "scope_order": {
          "oneOf": [
            {"const": ["day1", "day2", "all_constructed"]},
            {"const": ["all_constructed"]}
          ]
        },
        "default_scope": {"const": "all_constructed"},
        "quality_status": {"enum": ["pass", "warning"]},
        "matchup_compatibility": {"$ref": "#/$defs/matchup_compatibility"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_structure": {"const": "constructed_single_stage"}
            },
            "required": ["event_structure"]
          },
          "then": {
            "properties": {
              "scope_order": {"const": ["all_constructed"]}
            }
          },
          "else": {
            "properties": {
              "scope_order": {"const": ["day1", "day2", "all_constructed"]}
            }
          }
        }
      ]
    },
    "matchup_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "product",
        "format",
        "scope",
        "matchup_schema_version",
        "matchup_sha256",
        "taxonomy_schema_version",
        "taxonomy_sha256",
        "quality_blocking"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "source": {"const": "melee"},
        "product": {"const": "tabletop-major-events"},
        "format": {"$ref": "melee-event-statistics-common.schema.json#/$defs/id"},
        "scope": {"const": "all_constructed"},
        "matchup_schema_version": {"type": "string", "minLength": 1},
        "matchup_sha256": {"$ref": "melee-event-statistics-common.schema.json#/$defs/sha256"},
        "taxonomy_schema_version": {"type": "string", "minLength": 1},
        "taxonomy_sha256": {"$ref": "melee-event-statistics-common.schema.json#/$defs/sha256"},
        "quality_blocking": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "events": {
            "items": {"required": ["matchup_compatibility"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "1.2.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["active_taxonomy"],
        "properties": {
          "events": {
            "items": {"required": ["matchup_compatibility"]}
          }
        }
      }
    }
  ]
}
