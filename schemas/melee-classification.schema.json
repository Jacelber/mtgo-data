{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jacelber/mtgo-data/schemas/melee-classification.schema.json",
  "x-schema-version": "1.0.0",
  "title": "Melee event classification overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source", "event_id", "format", "classifier", "input",
    "taxonomy", "summary", "quality", "records"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source": {"const": "melee"},
    "event_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "format": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "classifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contract_version"],
      "properties": {
        "name": {"const": "shared-rule-classifier"},
        "contract_version": {"const": "1.0.0"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_path", "event_sha256", "event_schema_version",
        "event_decklist_count", "submitted_format_decklist_count",
        "excluded_decklist_count"
      ],
      "properties": {
        "event_path": {
          "type": "string",
          "pattern": "^data/[a-z0-9]+(?:-[a-z0-9]+)*/melee/events/[1-9][0-9]*\\.json$"
        },
        "event_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "event_schema_version": {"type": "string", "minLength": 1},
        "event_decklist_count": {"type": "integer", "minimum": 0},
        "submitted_format_decklist_count": {"type": "integer", "minimum": 0},
        "excluded_decklist_count": {"type": "integer", "minimum": 0}
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_path", "rule_sha256", "rule_schema_version",
        "archetype_count", "rule_count", "subtype_count"
      ],
      "properties": {
        "rule_path": {
          "type": "string",
          "pattern": "^my_archetypes/[a-z0-9]+(?:-[a-z0-9]+)*\\.yaml$"
        },
        "rule_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rule_schema_version": {"type": "string", "minLength": 1},
        "archetype_count": {"type": "integer", "minimum": 1},
        "rule_count": {"type": "integer", "minimum": 1},
        "subtype_count": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {"$ref": "#/$defs/summary"},
    "quality": {"$ref": "#/$defs/quality"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/classification_record"}
    }
  },
  "$defs": {
    "nullable_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "selected": {
      "type": ["object", "null"],
      "required": [
        "archetype_id", "archetype_name", "subtype_id", "subtype_name",
        "rule_id", "priority"
      ],
      "properties": {
        "archetype_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "archetype_name": {"type": "string", "minLength": 1},
        "subtype_id": {"$ref": "#/$defs/nullable_id"},
        "subtype_name": {"type": ["string", "null"], "minLength": 1},
        "rule_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "priority": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "condition_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card", "zone", "actual_count", "min_count", "max_count", "exact_count"
      ],
      "properties": {
        "card": {"type": "string", "minLength": 1},
        "zone": {"enum": ["any", "main", "side"]},
        "actual_count": {"type": "integer", "minimum": 0},
        "min_count": {"type": ["integer", "null"], "minimum": 0},
        "max_count": {"type": ["integer", "null"], "minimum": 0},
        "exact_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "rule_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype_id", "archetype_name", "subtype_id", "subtype_name",
        "rule_id", "priority", "evidence"
      ],
      "properties": {
        "archetype_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "archetype_name": {"type": "string", "minLength": 1},
        "subtype_id": {"$ref": "#/$defs/nullable_id"},
        "subtype_name": {"type": ["string", "null"], "minLength": 1},
        "rule_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "priority": {"type": "integer", "minimum": 0},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/condition_evidence"}
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "quantity": {"type": "integer", "minimum": 1}
      }
    },
    "unknown_deck": {
      "type": ["object", "null"],
      "required": ["main_deck", "sideboard"],
      "properties": {
        "main_deck": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/card"}
        },
        "sideboard": {
          "type": "array",
          "items": {"$ref": "#/$defs/card"}
        }
      },
      "additionalProperties": false
    },
    "classification_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id", "classification_status", "selected", "matched_rules",
        "top_priority_matches", "overridden_matches", "conflict_matches",
        "conflict_kind", "priority_tie", "errors", "unknown_deck"
      ],
      "properties": {
        "participant_id": {"type": "string", "minLength": 1},
        "classification_status": {
          "enum": ["classified", "unknown", "conflict", "invalid_deck"]
        },
        "selected": {"$ref": "#/$defs/selected"},
        "matched_rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule_match"}
        },
        "top_priority_matches": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule_match"}
        },
        "overridden_matches": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule_match"}
        },
        "conflict_matches": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule_match"}
        },
        "conflict_kind": {
          "type": ["string", "null"],
          "enum": ["parent_archetype", "subtype", null]
        },
        "priority_tie": {"type": "boolean"},
        "errors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "unknown_deck": {"$ref": "#/$defs/unknown_deck"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"classification_status": {"const": "classified"}},
            "required": ["classification_status"]
          },
          "then": {
            "properties": {
              "selected": {"type": "object"},
              "matched_rules": {"minItems": 1},
              "top_priority_matches": {"minItems": 1},
              "conflict_matches": {"maxItems": 0},
              "conflict_kind": {"type": "null"},
              "errors": {"maxItems": 0},
              "unknown_deck": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"classification_status": {"const": "unknown"}},
            "required": ["classification_status"]
          },
          "then": {
            "properties": {
              "selected": {"type": "null"},
              "matched_rules": {"maxItems": 0},
              "top_priority_matches": {"maxItems": 0},
              "overridden_matches": {"maxItems": 0},
              "conflict_matches": {"maxItems": 0},
              "conflict_kind": {"type": "null"},
              "errors": {"maxItems": 0},
              "unknown_deck": {"type": "object"}
            }
          }
        },
        {
          "if": {
            "properties": {"classification_status": {"const": "conflict"}},
            "required": ["classification_status"]
          },
          "then": {
            "properties": {
              "selected": {"type": "null"},
              "matched_rules": {"minItems": 2},
              "top_priority_matches": {"minItems": 2},
              "conflict_matches": {"minItems": 2},
              "conflict_kind": {
                "enum": ["parent_archetype", "subtype"]
              },
              "errors": {"maxItems": 0},
              "unknown_deck": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"classification_status": {"const": "invalid_deck"}},
            "required": ["classification_status"]
          },
          "then": {
            "properties": {
              "selected": {"type": "null"},
              "matched_rules": {"maxItems": 0},
              "top_priority_matches": {"maxItems": 0},
              "overridden_matches": {"maxItems": 0},
              "conflict_matches": {"maxItems": 0},
              "conflict_kind": {"type": "null"},
              "errors": {"minItems": 1},
              "unknown_deck": {"type": "null"}
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_records", "classified", "unknown", "conflicts", "invalid_decks",
        "multiple_matches", "overridden_matches", "selected_subtypes",
        "parent_only", "same_parent_multiple_subtype_matches",
        "residual_subtype_violations", "selected_by_parent",
        "selected_by_subtype", "strict_validation"
      ],
      "properties": {
        "total_records": {"type": "integer", "minimum": 0},
        "classified": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "conflicts": {"type": "integer", "minimum": 0},
        "invalid_decks": {"type": "integer", "minimum": 0},
        "multiple_matches": {"type": "integer", "minimum": 0},
        "overridden_matches": {"type": "integer", "minimum": 0},
        "selected_subtypes": {"type": "integer", "minimum": 0},
        "parent_only": {"type": "integer", "minimum": 0},
        "same_parent_multiple_subtype_matches": {"type": "integer", "minimum": 0},
        "residual_subtype_violations": {"type": "integer", "minimum": 0},
        "selected_by_parent": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "selected_by_subtype": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "strict_validation": {"enum": ["pass", "fail"]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking", "blocking_reasons", "unknowns_blocking"],
      "properties": {
        "status": {"enum": ["pass", "blocked"]},
        "blocking": {"type": "boolean"},
        "blocking_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "classification_conflicts", "invalid_decks",
              "residual_subtype_violations"
            ]
          }
        },
        "unknowns_blocking": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
          "then": {
            "properties": {
              "blocking": {"const": false},
              "blocking_reasons": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
          "then": {
            "properties": {
              "blocking": {"const": true},
              "blocking_reasons": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
