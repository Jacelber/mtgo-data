{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jacelber/mtgo-data/schemas/melee-minimized-resource.schema.json",
  "x-schema-version": "2.0.0",
  "title": "Melee minimized persisted resource",
  "oneOf": [
    {"$ref": "#/$defs/tournamentResource"},
    {"$ref": "#/$defs/standingsResourceV1"},
    {"$ref": "#/$defs/standingsResourceV2"},
    {"$ref": "#/$defs/matchesResourceV1"},
    {"$ref": "#/$defs/matchesResourceV2"},
    {"$ref": "#/$defs/decklistResourceV1"},
    {"$ref": "#/$defs/decklistResourceV2"}
  ],
  "$defs": {
    "nonEmptyText": {"type": "string", "minLength": 1},
    "positiveSourceId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "opaqueSourceId": {"type": "string", "minLength": 1},
    "decklistId": {"type": "string", "pattern": "^[0-9A-Fa-f-]{32,36}$"},
    "participantRef": {"type": "string", "pattern": "^melee-v3-[0-9a-f]{64}$"},
    "tournament": {
      "type": "object", "additionalProperties": false,
      "required": ["source_event_id", "name"],
      "properties": {
        "source_event_id": {"$ref": "#/$defs/positiveSourceId"},
        "name": {"$ref": "#/$defs/nonEmptyText"},
        "start_text": {"$ref": "#/$defs/nonEmptyText"},
        "end_text": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "round": {
      "type": "object", "additionalProperties": false,
      "required": ["source_round_id", "label"],
      "properties": {
        "source_round_id": {"$ref": "#/$defs/positiveSourceId"},
        "label": {"$ref": "#/$defs/nonEmptyText"},
        "number": {"type": "integer", "minimum": 1}
      }
    },
    "standingV1": {
      "type": "object", "additionalProperties": false,
      "required": ["source_standing_id", "participant_ref", "display_name"],
      "properties": {
        "source_standing_id": {"$ref": "#/$defs/opaqueSourceId"},
        "participant_ref": {"$ref": "#/$defs/participantRef"},
        "display_name": {"$ref": "#/$defs/nonEmptyText"},
        "rank": {"type": "integer", "minimum": 1},
        "match_points": {"type": "integer", "minimum": 0},
        "record_text": {"$ref": "#/$defs/nonEmptyText"},
        "status_text": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "standingV2": {
      "type": "object", "additionalProperties": false,
      "required": ["source_standing_id", "source_participant_id", "display_name"],
      "properties": {
        "source_standing_id": {"$ref": "#/$defs/opaqueSourceId"},
        "source_participant_id": {"$ref": "#/$defs/positiveSourceId"},
        "display_name": {"$ref": "#/$defs/nonEmptyText"},
        "rank": {"type": "integer", "minimum": 1},
        "match_points": {"type": "integer", "minimum": 0},
        "record_text": {"$ref": "#/$defs/nonEmptyText"},
        "status_text": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "decklistUrl": {"type": "string", "pattern": "^https://melee\\.gg/Decklist/GetDecklistDetails\\?id=[0-9A-Fa-f-]{32,36}$"},
    "decklistReferenceV1": {
      "type": "object", "additionalProperties": false,
      "required": ["source_decklist_id", "participant_ref", "url"],
      "properties": {"source_decklist_id": {"$ref": "#/$defs/decklistId"}, "participant_ref": {"$ref": "#/$defs/participantRef"}, "url": {"$ref": "#/$defs/decklistUrl"}}
    },
    "decklistReferenceV2": {
      "type": "object", "additionalProperties": false,
      "required": ["source_decklist_id", "source_participant_id", "url"],
      "properties": {"source_decklist_id": {"$ref": "#/$defs/decklistId"}, "source_participant_id": {"$ref": "#/$defs/positiveSourceId"}, "url": {"$ref": "#/$defs/decklistUrl"}}
    },
    "competitorV1": {
      "type": "object", "additionalProperties": false, "required": ["participant_ref"],
      "properties": {"participant_ref": {"$ref": "#/$defs/participantRef"}, "outcome_text": {"$ref": "#/$defs/nonEmptyText"}, "match_points": {"type": "integer", "minimum": 0}}
    },
    "competitorV2": {
      "type": "object", "additionalProperties": false, "required": ["source_participant_id"],
      "properties": {"source_participant_id": {"$ref": "#/$defs/positiveSourceId"}, "outcome_text": {"$ref": "#/$defs/nonEmptyText"}, "match_points": {"type": "integer", "minimum": 0}}
    },
    "matchBase": {
      "type": "object", "additionalProperties": false,
      "required": ["source_match_id", "source_round_id", "competitors"],
      "properties": {
        "source_match_id": {"$ref": "#/$defs/opaqueSourceId"},
        "source_round_id": {"$ref": "#/$defs/positiveSourceId"},
        "competitors": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true},
        "result_text": {"$ref": "#/$defs/nonEmptyText"},
        "status_text": {"$ref": "#/$defs/nonEmptyText"},
        "table_number": {"type": "integer", "minimum": 1}
      }
    },
    "matchV1": {"$ref": "#/$defs/matchBase", "properties": {"competitors": {"items": {"$ref": "#/$defs/competitorV1"}}}},
    "matchV2": {"$ref": "#/$defs/matchBase", "properties": {"competitors": {"items": {"$ref": "#/$defs/competitorV2"}}}},
    "card": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "quantity", "section_text"],
      "properties": {"name": {"$ref": "#/$defs/nonEmptyText"}, "quantity": {"type": "integer", "minimum": 1}, "section_text": {"$ref": "#/$defs/nonEmptyText"}}
    },
    "decklistV1": {
      "type": "object", "additionalProperties": false,
      "required": ["source_decklist_id", "participant_ref", "cards"],
      "properties": {"source_decklist_id": {"$ref": "#/$defs/decklistId"}, "participant_ref": {"$ref": "#/$defs/participantRef"}, "format_text": {"$ref": "#/$defs/nonEmptyText"}, "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}}}
    },
    "decklistV2": {
      "type": "object", "additionalProperties": false,
      "required": ["source_decklist_id", "source_participant_id", "cards"],
      "properties": {"source_decklist_id": {"$ref": "#/$defs/decklistId"}, "source_participant_id": {"$ref": "#/$defs/positiveSourceId"}, "format_text": {"$ref": "#/$defs/nonEmptyText"}, "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}}}
    },
    "tournamentResource": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "resource_type", "tournament", "rounds"],
      "properties": {"schema_version": {"enum": ["1.0.0", "2.0.0"]}, "resource_type": {"const": "tournament"}, "tournament": {"$ref": "#/$defs/tournament"}, "rounds": {"type": "array", "items": {"$ref": "#/$defs/round"}}}
    },
    "standingsResourceBase": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "resource_type", "records_total", "standings", "decklist_references"],
      "properties": {"schema_version": {}, "resource_type": {"const": "standings"}, "records_total": {"type": "integer", "minimum": 0}, "standings": {"type": "array"}, "decklist_references": {"type": "array"}}
    },
    "standingsResourceV1": {"$ref": "#/$defs/standingsResourceBase", "properties": {"schema_version": {"const": "1.0.0"}, "standings": {"items": {"$ref": "#/$defs/standingV1"}}, "decklist_references": {"items": {"$ref": "#/$defs/decklistReferenceV1"}}}},
    "standingsResourceV2": {"$ref": "#/$defs/standingsResourceBase", "properties": {"schema_version": {"const": "2.0.0"}, "standings": {"items": {"$ref": "#/$defs/standingV2"}}, "decklist_references": {"items": {"$ref": "#/$defs/decklistReferenceV2"}}}},
    "matchesResourceBase": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "resource_type", "records_total", "matches"],
      "properties": {"schema_version": {}, "resource_type": {"const": "matches"}, "records_total": {"type": "integer", "minimum": 0}, "matches": {"type": "array"}}
    },
    "matchesResourceV1": {"$ref": "#/$defs/matchesResourceBase", "properties": {"schema_version": {"const": "1.0.0"}, "matches": {"items": {"$ref": "#/$defs/matchV1"}}}},
    "matchesResourceV2": {"$ref": "#/$defs/matchesResourceBase", "properties": {"schema_version": {"const": "2.0.0"}, "matches": {"items": {"$ref": "#/$defs/matchV2"}}}},
    "decklistResourceBase": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "resource_type", "decklists"],
      "properties": {"schema_version": {}, "resource_type": {"const": "decklist"}, "decklists": {"type": "array", "minItems": 1, "maxItems": 1}}
    },
    "decklistResourceV1": {"$ref": "#/$defs/decklistResourceBase", "properties": {"schema_version": {"const": "1.0.0"}, "decklists": {"items": {"$ref": "#/$defs/decklistV1"}}}},
    "decklistResourceV2": {"$ref": "#/$defs/decklistResourceBase", "properties": {"schema_version": {"const": "2.0.0"}, "decklists": {"items": {"$ref": "#/$defs/decklistV2"}}}}
  }
}
